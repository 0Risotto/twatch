{
  "name": "twatch-electron",
  "version": "0.2.5",
  "private": true,
  "description": "Desktop shell for the twatch local console",
  "homepage": "https://github.com/0Risotto/twatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/0Risotto/twatch.git"
  },
  "author": {
    "name": "0Risotto",
    "email": "anasjallad19@gmail.com",
    "url": "https://github.com/0Risotto"
  },
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:media": "node scripts/prepare-media.cjs",
    "dist": "npm run prepare:media && electron-builder --publish never",
    "dist:linux": "npm run prepare:media && electron-builder --publish never --linux AppImage deb",
    "dist:win": "npm run prepare:media && electron-builder --publish never --win portable nsis"
  },
  "devDependencies": {
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
